<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ShilpiDB.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShilpiDB.Desktop.Controls"
    Title="ShilpiDB Desktop">
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="160" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="ShilpiDB" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Desktop" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    x:Name="HostBox"
                    Width="200"
                    Text="127.0.0.1:7420"
                    PlaceholderText="host:port"
                    AutomationProperties.Name="Server address"
                    KeyDown="HostBox_KeyDown" />
                <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="Connect_Click" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" />
                <Button x:Name="StartLocalButton" Content="Start local server" Click="StartLocal_Click" ToolTipService.ToolTip="Launch shilpid on a free local port" />
                <Button
                    x:Name="ThemeButton"
                    Content="Dark"
                    MinWidth="72"
                    Click="ThemeButton_Click"
                    AutomationProperties.Name="Theme"
                    ToolTipService.ToolTip="Switch to light theme" />
                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />
                <Border x:Name="StatusPill" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="DISCONNECTED" FontSize="11" CharacterSpacing="60" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="16,8,16,0" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="12" Padding="12">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Query" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="min x" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="QueryMinX" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="-100" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="min y" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="QueryMinY" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="-100" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="max x" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="QueryMaxX" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="max y" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="QueryMaxY" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="100" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="QueryButton" Content="Run bbox query" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Query_Click" />
                            <TextBlock Text="Matches stay bright on the canvas and in the table. The dashed rectangle is the query window." Style="{StaticResource Hint}" />
                            <TextBlock x:Name="QueryResult" Style="{StaticResource Hint}" />
                            <Button x:Name="ClearQueryButton" Content="Show all records" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ClearQuery_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Insert record" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="id" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="InsertId" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="1" Minimum="0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="min x" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="InsertMinX" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="min y" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="InsertMinY" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="max x" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="InsertMaxX" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="10" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="max y" Style="{StaticResource FieldLabel}" />
                                    <NumberBox x:Name="InsertMaxY" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="10" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="payload text" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox x:Name="InsertPayload" PlaceholderText="optional text" />
                            <Button x:Name="InsertButton" Content="Insert / replace" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Insert_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Selected record" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DetailEmpty" Text="Click a record in the table or on the canvas." Style="{StaticResource Hint}" Margin="0" />
                            <StackPanel x:Name="DetailBody" Visibility="Collapsed" Spacing="8">
                                <StackPanel>
                                    <TextBlock Text="id" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DetailId" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="bbox" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DetailBbox" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="payload (text)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="payload (hex)" Style="{StaticResource FieldLabel}" />
                                    <ScrollViewer MaxHeight="96">
                                        <TextBlock x:Name="DetailHex" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                            <Button
                                x:Name="DeleteButton"
                                Content="Delete this record"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="Delete_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Database" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="StatsText" Text="Not connected." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="SaveButton" Content="Save to disk" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Save_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="180" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                    <controls:SpatialCanvas x:Name="Spatial" />
                    <Border
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,4"
                        CornerRadius="999"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                        <TextBlock x:Name="RecordCountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MatchSummary" Margin="12,8,12,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Row="1" Margin="0,4,0,0" Padding="0,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="10,0" Text="id" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Margin="10,0" Text="min x" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Margin="10,0" Text="min y" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Margin="10,0" Text="max x" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Margin="10,0" Text="max y" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{Binding Records}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{Binding RowBackground}"
                                        Opacity="{Binding RowOpacity}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Tag="{Binding Id}"
                                        PointerPressed="RecordRow_PointerPressed"
                                        PointerEntered="RecordRow_PointerEntered"
                                        PointerExited="RecordRow_PointerExited">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{Binding MatchBarVisibility}" />
                                            <TextBlock Grid.Column="1" Margin="10,7" Text="{Binding IdText}" />
                                            <TextBlock Grid.Column="2" Margin="10,7" Text="{Binding MinXText}" />
                                            <TextBlock Grid.Column="3" Margin="10,7" Text="{Binding MinYText}" />
                                            <TextBlock Grid.Column="4" Margin="10,7" Text="{Binding MaxXText}" />
                                            <TextBlock Grid.Column="5" Margin="10,7" Text="{Binding MaxYText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
